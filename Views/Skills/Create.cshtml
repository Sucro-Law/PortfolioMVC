@model PortfolioMVC.Models.Skill
@{
    ViewData["Title"] = "Add Skill";
    var categories = new[] { "Frontend", "Backend", "Database", "Tools", "Other" };
}

<section class="page-hero">
    <div class="container">
        <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left me-1"></i> All Skills</a>
        <h1 class="page-hero-title mt-3">Add New Skill</h1>
    </div>
</section>

<section class="py-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="form-card">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label-custom">Skill Name *</label>
                            <input asp-for="Name" class="form-control form-control-custom" placeholder="e.g., Vue.js" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Category" class="form-label-custom">Category</label>
                            <select asp-for="Category" class="form-select form-control-custom">
                                <option value="">— Select category —</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Proficiency" class="form-label-custom">
                                Proficiency: <span id="profVal">@Model.Proficiency</span>%
                            </label>
                            <input asp-for="Proficiency" type="range" min="0" max="100" step="5"
                                   class="form-range"
                                   oninput="document.getElementById('profVal').textContent=this.value" />
                            <span asp-validation-for="Proficiency" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary-custom">
                                <i class="bi bi-plus-circle me-1"></i> Add Skill
                            </button>
                            <a asp-action="Index" class="btn btn-outline-custom">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
