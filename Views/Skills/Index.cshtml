@model IEnumerable<PortfolioMVC.Models.Skill>
@{
    ViewData["Title"] = "Manage Skills";
    var grouped = Model.GroupBy(s => s.Category ?? "Other").OrderBy(g => g.Key);
}

<section class="page-hero">
    <div class="container">
        <div class="section-label">Admin</div>
        <h1 class="page-hero-title">Manage Skills</h1>
        <p class="page-hero-sub">Add, edit, or remove skills shown on your portfolio.</p>
    </div>
</section>

<section class="py-section">
    <div class="container">
        <div class="d-flex justify-content-end mb-4">
            <a asp-action="Create" class="btn btn-primary-custom">
                <i class="bi bi-plus-lg me-1"></i> Add Skill
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-tools"></i>
                <p>No skills yet. Add your first one!</p>
            </div>
        }
        else
        {
            @foreach (var group in grouped)
            {
                <div class="mb-5">
                    <h5 class="detail-section-label mb-3">
                        <i class="bi bi-tag me-1"></i> @group.Key
                    </h5>
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Skill</th>
                                    <th style="width:50%">Proficiency</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var skill in group)
                                {
                                    <tr>
                                        <td class="fw-semibold">@skill.Name</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress flex-grow-1" style="height:8px;">
                                                    <div class="progress-bar" role="progressbar"
                                                         style="width:@skill.Proficiency%; background: var(--accent);"
                                                         aria-valuenow="@skill.Proficiency" aria-valuemin="0" aria-valuemax="100">
                                                    </div>
                                                </div>
                                                <span class="small text-muted" style="min-width:34px;">@skill.Proficiency%</span>
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex gap-2 justify-content-end">
                                                <a asp-action="Edit" asp-route-id="@skill.Id" class="btn btn-sm btn-edit">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@skill.Id" class="btn btn-sm btn-danger-soft">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </div>
</section>
