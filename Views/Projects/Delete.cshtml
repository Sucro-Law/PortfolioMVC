@model PortfolioMVC.Models.Project
@{
    ViewData["Title"] = "Delete Project";
}

<section class="page-hero">
    <div class="container">
        <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left me-1"></i> All Projects</a>
        <h1 class="page-hero-title mt-3">Delete Project</h1>
    </div>
</section>

<section class="py-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="form-card border-danger-soft">
                    <div class="text-center mb-4">
                        <div class="delete-icon-wrap">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>
                        <h4 class="mt-3">Are you sure you want to delete this project?</h4>
                        <p class="text-muted">This action cannot be undone.</p>
                    </div>

                    <div class="delete-preview mb-4">
                        <strong>@Model.Title</strong>
                        <p class="mb-0 small text-muted mt-1">@(Model.Description.Length > 100 ? Model.Description[..100] + "…" : Model.Description)</p>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-3 justify-content-center">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-1"></i> Yes, Delete
                            </button>
                            <a asp-action="Index" class="btn btn-outline-custom">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
