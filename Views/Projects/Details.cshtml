@model PortfolioMVC.Models.Project
@{
    ViewData["Title"] = Model.Title;
}

<section class="page-hero">
    <div class="container">
        <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left me-1"></i> All Projects</a>
        <div class="mt-3">
            @if (Model.IsFeatured)
            {
                <span class="featured-badge mb-2 d-inline-block"><i class="bi bi-star-fill"></i> Featured Project</span>
            }
            <h1 class="page-hero-title">@Model.Title</h1>
            <p class="page-hero-sub text-muted small">Added @Model.CreatedAt.ToString("MMMM dd, yyyy")</p>
        </div>
    </div>
</section>

<section class="py-section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-8">
                <div class="detail-card">
                    <h5 class="detail-section-label">About This Project</h5>
                    <p class="detail-desc">@Model.Description</p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="detail-sidebar">
                    @if (!string.IsNullOrEmpty(Model.TechStack))
                    {
                        <div class="sidebar-block">
                            <div class="sidebar-label"><i class="bi bi-stack me-1"></i> Tech Stack</div>
                            <div class="tech-tags">
                                @foreach (var tech in Model.TechStack.Split(','))
                                {
                                    <span class="tech-tag">@tech.Trim()</span>
                                }
                            </div>
                        </div>
                    }
                    <div class="sidebar-block">
                        <div class="sidebar-label"><i class="bi bi-link-45deg me-1"></i> Links</div>
                        <div class="d-flex flex-column gap-2">
                            @if (!string.IsNullOrEmpty(Model.GitHubUrl))
                            {
                                <a href="@Model.GitHubUrl" target="_blank" class="btn btn-github w-100">
                                    <i class="bi bi-github me-2"></i> View on GitHub
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(Model.LiveUrl))
                            {
                                <a href="@Model.LiveUrl" target="_blank" class="btn btn-primary-custom w-100">
                                    <i class="bi bi-box-arrow-up-right me-2"></i> Live Demo
                                </a>
                            }
                        </div>
                    </div>
                    <div class="sidebar-block">
                        <div class="sidebar-label"><i class="bi bi-gear me-1"></i> Actions</div>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-edit flex-fill">
                                <i class="bi bi-pencil me-1"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger-soft flex-fill">
                                <i class="bi bi-trash me-1"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
